{
  "name": "webhook-dispatch",
  "version": "0.0.0",
  "private": true,
  "description": "Build webhook delivery into your TypeScript application.",
  "license": "MIT",
  "author": "pplytas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pplytas/webhook-dispatch.git"
  },
  "homepage": "https://github.com/pplytas/webhook-dispatch#readme",
  "bugs": {
    "url": "https://github.com/pplytas/webhook-dispatch/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./migrations/001-initial.sql": "./migrations/001-initial.sql"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "docs",
    "examples",
    "GLOSSARY.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run build && tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "npm run build && vitest run test/crypto.test.ts test/transport.test.ts test/config.test.ts test/verify.test.ts test/receiver-example.test.ts",
    "prepack": "npm run build",
    "example": "npm run build && node examples/basic/demo.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
