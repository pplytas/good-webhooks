{
  "name": "good-webhooks-better-auth-billing-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node src/setup.ts",
    "build": "esbuild src/client.ts --bundle --format=esm --target=es2022 --outfile=public/client.js",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node --env-file=.env src/dev.ts",
    "start": "node --env-file=.env src/server.ts",
    "receiver": "node --env-file=.env src/receiver.ts",
    "worker": "node --env-file=.env src/worker.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 test/workflow.test.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "express": "5.2.1",
    "good-webhooks": "0.1.0-alpha.4",
    "pg": "8.16.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
